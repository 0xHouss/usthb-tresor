datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Auth models and enums

enum UserRole {
  User
  Moderator
  Admin
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(User)
  accounts      Account[]
  sessions      Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  File File[]
  PendingFile PendingFile[]
  events      EventLog[]
  comments    Comment[]

  reportsFiled   Report[] @relation("ReportsFiled")
  reportsHandled Report[] @relation("ReportsHandled")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}

// File model and enums

enum FileStatus {
  Pending
  Approved
  Rejected
}

enum FileType {
  Lecture
  DW_Worksheet
  PW_Worksheet
  Interrogation
  Exam
  PW_Exam
}

enum AcademicLevel {
  L1
  L2
  L3
  M1
  M2
  D1
  D2
  D3
  ING1
  ING2
  ING3
  ING4
  ING5
}

enum Semester {
  S1
  S2
}

// Language a document is written in (independent of the UI language).
enum Language {
  French
  English
}

model PendingFile {
  id      String @id @default(cuid())
  driveId String @unique

  type FileType

  academicLevel AcademicLevel
  academicYear  Int
  semester      Semester
  section       String
  group         String?

  majorName     String
  moduleName    String
  professorFullName String

  status     FileStatus @default(Pending)

  language Language @default(French)

  // Hides the uploader from public views; moderators and admins still see it.
  anonymous Boolean @default(false)

  uploadedAt      DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedByEmail], references: [email])
  uploadedByEmail String
}

model File {
  id      String @id @default(cuid())
  driveId String @unique

  type FileType

  academicLevel AcademicLevel
  academicYear  Int
  semester      Semester
  section       String
  group         String?

  major     Major  @relation(fields: [majorName], references: [name])
  majorName String

  module     Module @relation(fields: [moduleName], references: [name])
  moduleName String

  professor         Professor @relation(fields: [professorFullName], references: [fullName])
  professorFullName String

  uploadedAt DateTime   @default(now())

  language Language @default(French)

  // Hides the uploader from public views; moderators and admins still see it.
  anonymous Boolean @default(false)

  uploadedBy      User   @relation(fields: [uploadedByEmail], references: [email])
  uploadedByEmail String

  comments  Comment[]
  reports   Report[]
  downloads FileDownload[]
}

model Professor {
  id       String @id @default(cuid())
  fullName String @unique

  File File[]
}

model Module {
  id  String @id @default(cuid())
  name String @unique

  File File[]
}

model Major {
  id   String @id @default(cuid())
  name String @unique

  File File[]
}

// Download tracking. Deliberately anonymous: no user is stored.

model FileDownload {
  id String @id @default(cuid())

  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId String

  createdAt DateTime @default(now())

  @@index([fileId])
  @@index([createdAt])
}

// Comments

model Comment {
  id      String @id @default(cuid())
  content String

  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId String

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fileId, createdAt])
}

// Problem reports

enum ReportReason {
  CorruptedFile
  WrongMetadata
  Copyright
  Other
}

enum ReportStatus {
  Open
  Resolved
  Dismissed
}

model Report {
  id      String       @id @default(cuid())
  reason  ReportReason
  details String?
  status  ReportStatus @default(Open)

  // Kept null once the file is deleted, so the report history survives.
  file   File?   @relation(fields: [fileId], references: [id], onDelete: SetNull)
  fileId String?
  // Snapshot of the file's details, for reports whose file was deleted.
  fileMetadata Json

  reporter   User   @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String

  resolvedBy   User?     @relation("ReportsHandled", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedById String?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([fileId])
}

// Audit log

enum EventType {
  UserLogin
  FileSubmitted
  FileApproved
  FileRejected
  CommentCreated
  CommentDeleted
  ReportCreated
  ReportResolved
  ReportDismissed
  FileDeleted
}

model EventLog {
  id   String    @id @default(cuid())
  type EventType

  // Who performed the action; kept null if that user is later deleted.
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId String?

  // Id of the record the event is about (PendingFile, File, ...), if any.
  targetId String?
  // Snapshot of the target's details, so the entry still reads well if it's deleted.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([actorId])
}
